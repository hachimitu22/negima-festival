        <mxCell id="f-scene-dialogue" style="endArrow=block;html=1;rounded=0;strokeColor=#7C3AED;" edge="1" parent="1" source="flow-scene-update" target="flow-dialogue-begin">
          <mxGeometry relative="1" as="geometry"/>
