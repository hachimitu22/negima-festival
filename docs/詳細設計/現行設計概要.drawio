        <mxCell id="f-render-loop" value="next frame" style="endArrow=block;html=1;rounded=0;strokeColor=#2563EB;" edge="1" parent="1" source="flow-render" target="flow-raf">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
