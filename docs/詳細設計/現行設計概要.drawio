        <mxCell id="f-dialogue-active" style="endArrow=block;html=1;rounded=0;strokeColor=#7C3AED;" edge="1" parent="1" source="flow-dialogue-begin" target="flow-active-conv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-active-blocked" value="yes" style="endArrow=block;html=1;rounded=0;strokeColor=#D97706;" edge="1" parent="1" source="flow-active-conv" target="flow-blocked">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-active-start" value="no" style="endArrow=block;html=1;rounded=0;strokeColor=#F97316;" edge="1" parent="1" source="flow-active-conv" target="flow-start-conv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-start-control" style="endArrow=block;html=1;rounded=0;strokeColor=#0EA5E9;" edge="1" parent="1" source="flow-start-conv" target="flow-frame-control">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-control-branch" style="endArrow=block;html=1;rounded=0;strokeColor=#D97706;" edge="1" parent="1" source="flow-frame-control" target="flow-sim-blocked">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-sim-blocked" value="no" style="endArrow=block;html=1;rounded=0;strokeColor=#D97706;" edge="1" parent="1" source="flow-sim-blocked" target="flow-blocked">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-sim-player" value="yes" style="endArrow=block;html=1;rounded=0;strokeColor=#2563EB;" edge="1" parent="1" source="flow-sim-blocked" target="flow-player-control">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-player-cassiopeia" style="endArrow=block;html=1;rounded=0;strokeColor=#2563EB;" edge="1" parent="1" source="flow-player-control" target="flow-cassiopeia">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-cassiopeia-rewind" value="yes" style="endArrow=block;html=1;rounded=0;strokeColor=#DC2626;" edge="1" parent="1" source="flow-cassiopeia" target="flow-rewind">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-cassiopeia-time" value="no" style="endArrow=block;html=1;rounded=0;strokeColor=#2563EB;" edge="1" parent="1" source="flow-cassiopeia" target="flow-time">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-rewind-time" style="endArrow=block;html=1;rounded=0;strokeColor=#DC2626;" edge="1" parent="1" source="flow-rewind" target="flow-time">
          <mxGeometry relative="1" as="geometry"/>
