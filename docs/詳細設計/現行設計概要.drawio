  </diagram>
  <diagram id="lifecycle-flow" name="ライフサイクルフロー">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="flow-title" value="ライフサイクルフロー: 起動、フレーム更新、会話、イベント、巻き戻し" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="flow-start" value="window load" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#16A34A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="95" width="130" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="flow-bootstrap" value="index.js main()&lt;br&gt;DomGameView と MainGameScene を生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="250" y="90" width="230" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="flow-engine-new" value="new GameEngine({ initialScene, view })&lt;br&gt;view.configure({ enqueueInput })" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="540" y="85" width="290" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="flow-start-engine" value="engine.start()&lt;br&gt;view.init(initialSnapshot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="900" y="90" width="220" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="flow-raf" value="requestAnimationFrame loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="95" width="230" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="flow-update" value="GameEngine.update(now)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="245" width="220" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="flow-frame" value="frame更新&lt;br&gt;deltaTime / frameCount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="190" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="flow-input" value="inputQueueをdrain&lt;br&gt;context.inputsへ格納" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="650" y="240" width="210" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="flow-scene-update" value="MainGameScene.update({ context })" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="245" width="270" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="flow-dialogue-begin" value="DialogueSystem.beginFrame()&lt;br&gt;GameFlowSystem.beginFrame({ dialogue })&lt;br&gt;DialogueSystem.processInput(inputs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;" vertex="1" parent="1">
          <mxGeometry x="120" y="390" width="270" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="flow-active-conv" value="inputMode == dialogue?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="385" width="190" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="flow-blocked" value="GameFlowSystemが停止判定&lt;br&gt;時間 / 移動 / 場所訪問 / 通常入力を更新しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;" vertex="1" parent="1">
          <mxGeometry x="690" y="375" width="290" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="flow-start-conv" value="canProcessFieldInput() が trueなら&lt;br&gt;actor入力から会話開始判定&lt;br&gt;EventSystem.requestActorConversation()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#F97316;" vertex="1" parent="1">
          <mxGeometry x="690" y="510" width="310" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="flow-frame-control" value="GameFlowSystem.createControlContext({ dialogue })" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0EA5E9;" vertex="1" parent="1">
          <mxGeometry x="1070" y="505" width="260" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="flow-sim-blocked" value="gameplaySimulationEnabled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="485" width="200" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="flow-player-control" value="PlayerControlSystem.update(inputs, controlContext)&lt;br&gt;map / location / branch / cassiopeia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="130" y="680" width="290" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="flow-cassiopeia" value="カシオペア入力?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="665" width="160" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="flow-rewind" value="TimeControlSystem.useCassiopeia()&lt;br&gt;actor次回移動時刻リセット&lt;br&gt;DialogueSystem.dispose()&lt;br&gt;EventSystem.rewindTo(currentHours)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;" vertex="1" parent="1">
          <mxGeometry x="720" y="635" width="330" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="flow-time" value="TimeControlSystem.advance(frame)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="1150" y="655" width="270" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="flow-event-advance" value="EventSystem.advanceTo(currentHours)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E6;strokeColor=#F97316;" vertex="1" parent="1">
          <mxGeometry x="1150" y="745" width="270" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="flow-character" value="CharacterSystem.update(context)&lt;br&gt;主人公 / actor 移動更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="120" y="880" width="290" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="flow-location" value="LocationSystem.update()&lt;br&gt;訪問場所をEventSystem.visitLocations()へ通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="500" y="880" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="flow-snapshot" value="MainGameScene.createSnapshot()&lt;br&gt;System fragmentを集約" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1">
          <mxGeometry x="930" y="880" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="flow-render" value="DomGameView.render(snapshot)&lt;br&gt;sceneId維持、activeLayerIdで表示切替" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;" vertex="1" parent="1">
          <mxGeometry x="1320" y="880" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="flow-stop" value="stop / destroy&lt;br&gt;view.destroy()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="1320" y="1015" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f-start-bootstrap" style="endArrow=block;html=1;rounded=0;strokeColor=#4B5563;" edge="1" parent="1" source="flow-start" target="flow-bootstrap">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-bootstrap-engine" style="endArrow=block;html=1;rounded=0;strokeColor=#4B5563;" edge="1" parent="1" source="flow-bootstrap" target="flow-engine-new">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-engine-start" style="endArrow=block;html=1;rounded=0;strokeColor=#2563EB;" edge="1" parent="1" source="flow-engine-new" target="flow-start-engine">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-start-raf" style="endArrow=block;html=1;rounded=0;strokeColor=#2563EB;" edge="1" parent="1" source="flow-start-engine" target="flow-raf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-raf-update" style="endArrow=block;html=1;rounded=0;strokeColor=#2563EB;" edge="1" parent="1" source="flow-raf" target="flow-update">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-update-frame" style="endArrow=block;html=1;rounded=0;strokeColor=#2563EB;" edge="1" parent="1" source="flow-update" target="flow-frame">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-frame-input" style="endArrow=block;html=1;rounded=0;strokeColor=#2563EB;" edge="1" parent="1" source="flow-frame" target="flow-input">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f-input-scene" style="endArrow=block;html=1;rounded=0;strokeColor=#2563EB;" edge="1" parent="1" source="flow-input" target="flow-scene-update">
          <mxGeometry relative="1" as="geometry"/>
